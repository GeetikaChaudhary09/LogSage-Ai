
# ==========================================
# LogSage AI - Environment Configuration
# ==========================================

# Application
APP_NAME=LogSage-AI
APP_ENV=development

# PostgreSQL
POSTGRES_DB=logsage_db
POSTGRES_USER=logsage_user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=logsage_user
RABBITMQ_PASSWORD=CHANGE_ME

# Spring Boot Backend
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# JWT Authentication
JWT_SECRET=REPLACE_WITH_SECURE_RANDOM_SECRET
JWT_ACCESS_TOKEN_EXPIRATION=900
JWT_REFRESH_TOKEN_EXPIRATION=604800

# Python ML Service
ML_SERVICE_HOST=localhost
ML_SERVICE_PORT=8000

# Frontend
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Logging
LOG_LEVEL=INFO
